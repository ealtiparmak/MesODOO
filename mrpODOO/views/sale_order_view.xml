<odoo>
    <record id="view_order_form_inherit_bom_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bom.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//header" position="inside">
                <button name="get_bom_lines"
                        type="object"
                        string="Get BOM Components"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>